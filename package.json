{
  "name": "dtefk-system-optimized",
  "version": "1.0.0",
  "description": "Оптимізована система ДТЕФК з покращеним функціоналом",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.enterthg.dtefk-system-optimized",
    "productName": "ДТЕФК",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!**/.git",
      "!**/.github",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "dtefk-system-optimized-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.0"
  }
}
